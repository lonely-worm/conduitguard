# Exact frontend browser origins allowed by FastAPI; comma-separated for multiple hosts.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional PostgreSQL/Neon connection string. When configured, the API stores
# aggregate analysis counts only; submitted policies, probes, and evidence are not saved.
DATABASE_URL=

# Redis-compatible connection string used by the shared production rate limiter.
# Required when CONDUITGUARD_ENV=production; do not expose it to the browser.
REDIS_URL=

# Production enables the Redis-backed limiter by default. Keep local values false unless
# a local Redis-compatible service is configured.
CONDUITGUARD_ENV=development
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false
